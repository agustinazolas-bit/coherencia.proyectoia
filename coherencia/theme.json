{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 2,
  "settings": {
    "appearanceTools": true,
    "layout": {
      "contentSize": "1152px",
      "wideSize": "1280px"
    },
    "color": {
      "custom": true,
      "defaultPalette": true,
      "palette": [
        {
          "slug": "slate-950",
          "color": "#020617",
          "name": "Slate 950 (Fondo Terminal)"
        },
        {
          "slug": "slate-900",
          "color": "#0f172a",
          "name": "Slate 900 (Fondo Principal)"
        },
        {
          "slug": "slate-800",
          "color": "#1e293b",
          "name": "Slate 800 (Superficie Tarjetas)"
        },
        {
          "slug": "slate-100",
          "color": "#f1f5f9",
          "name": "Slate 100 (Texto Principal)"
        },
        {
          "slug": "indigo-500",
          "color": "#6366f1",
          "name": "Indigo 500 (Acento COHERENCIA)"
        },
        {
          "slug": "sky-400",
          "color": "#38bdf8",
          "name": "Sky 400 (Google Grounding)"
        },
        {
          "slug": "emerald-400",
          "color": "#34d399",
          "name": "Emerald 400 (Cumplida)"
        },
        {
          "slug": "amber-400",
          "color": "#fbbf24",
          "name": "Amber 400 (En Curso)"
        },
        {
          "slug": "rose-500",
          "color": "#f43f5e",
          "name": "Rose 500 (Bloqueada / Alerta)"
        }
      ]
    },
    "typography": {
      "fontFamilies": [
        {
          "fontFamily": "'Plus Jakarta Sans', system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif",
          "name": "Plus Jakarta Sans",
          "slug": "plus-jakarta-sans"
        },
        {
          "fontFamily": "ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace",
          "name": "Monospace Auditor",
          "slug": "monospace"
        }
      ]
    },
    "spacing": {
      "units": ["px", "em", "rem", "vh", "vw", "%"]
    }
  },
  "styles": {
    "color": {
      "background": "#0f172a",
      "text": "#f1f5f9"
    },
    "typography": {
      "fontFamily": "var(--wp--preset--font-family--plus-jakarta-sans)"
    }
  }
}
